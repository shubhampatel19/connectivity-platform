{
  "uid": "connectivity-overview",
  "title": "Connectivity overview",
  "tags": [
    "connectivity"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Edge agent: send failures by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (reason) (rate(connectivity_agent_send_failures_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Edge agent: buffered samples and drops",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(connectivity_agent_buffered_samples)",
          "legendFormat": "buffered"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(connectivity_agent_samples_dropped_total[1m]))",
          "legendFormat": "dropped/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Edge agent: send latency p50 / p95",
      "datasource": {
        "type": "prometheus",
