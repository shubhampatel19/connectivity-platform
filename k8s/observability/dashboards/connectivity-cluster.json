{
  "uid": "connectivity-cluster",
  "title": "Connectivity cluster",
  "tags": [
    "connectivity",
    "kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "app",
        "type": "custom",
        "label": "service",
        "current": {
          "text": "ingest-api",
          "value": "ingest-api"
        },
        "options": [
          {
            "text": "ingest-api",
            "value": "ingest-api",
            "selected": true
          },
          {
            "text": "telemetry-processor",
            "value": "telemetry-processor",
            "selected": false
          },
          {
            "text": "case-service",
            "value": "case-service",
            "selected": false
          },
          {
            "text": "kafka",
            "value": "kafka",
            "selected": false
          },
          {
            "text": "postgres",
            "value": "postgres",
            "selected": false
          },
          {
            "text": "object-store",
            "value": "object-store",
            "selected": false
          }
        ],
        "query": "ingest-api,telemetry-processor,case-service,kafka,postgres,object-store"
      }
    ]
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/connectivity-overview"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Kubernetes: pods",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Kafka brokers",
      "description": "Brokers in the cluster. 3 is healthy; with 2, producers still work (min ISR 2); with 1, every produce fails.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "max(kafka_brokers)",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Under-replicated partitions",
      "description": "Partitions missing a replica. Normal for a minute while a broker restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(kafka_topic_partition_under_replicated_partition) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Partitions below min ISR",
      "description": "Partitions where acks=all produces fail. Devices see 503s and buffer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "count(kafka_topic_partition_in_sync_replica < 2 and on (topic, partition) kafka_topic_partition_replicas >= 3) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Pod restarts (1h)",
      "description": "Container restarts in the namespace over the last hour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"connectivity\"}[1h])) or vector(0)",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Container restarts",
      "description": "Restarts per pod over 10 minutes. Check the last terminated reason with kubectl describe pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"connectivity\"}[10m])) > 0",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Unavailable or unready replicas",
      "description": "Deployments with unavailable replicas, StatefulSets with fewer ready than wanted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "kube_deployment_status_replicas_unavailable{namespace=\"connectivity\"} > 0",
          "legendFormat": "deploy {{deployment}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "kube_statefulset_replicas{namespace=\"connectivity\"} - kube_statefulset_status_replicas_ready{namespace=\"connectivity\"} > 0",
          "legendFormat": "sts {{statefulset}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memory working set vs limit",
      "description": "Fraction of the memory limit each container uses. At 1.0 the kernel OOM-kills it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "max by (pod) (container_memory_working_set_bytes{namespace=\"connectivity\",container!=\"\"}) / on (pod) max by (pod) (kube_pod_container_resource_limits{namespace=\"connectivity\",resource=\"memory\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "CPU use and throttling",
      "description": "CPU cores used per pod, and the share of scheduling periods in which the pod was throttled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"connectivity\",container!=\"\"}[1m]))",
          "legendFormat": "{{pod}} cores"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total{namespace=\"connectivity\",container!=\"\"}[2m])) / sum by (pod) (rate(container_cpu_cfs_periods_total{namespace=\"connectivity\",container!=\"\"}[2m])) > 0.05",
          "legendFormat": "{{pod}} throttled"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Kafka replication",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "In-sync replicas: minimum per topic",
      "description": "The weakest partition of each topic. Below 2 means acks=all produces to it fail.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "min by (topic) (kafka_topic_partition_in_sync_replica)",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Partition leaders per broker",
      "description": "Partitions led by each broker (-1: no leader, offline). After a broker restarts it leads nothing until Kafka's preferred-leader rebalance moves leadership back, about 5 minutes later.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "count_values(\"broker\", kafka_topic_partition_leader)",
          "legendFormat": "broker {{broker}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Consumer lag by group",
      "description": "Records produced but not yet processed, per consumer group.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (consumergroup) (kafka_consumergroup_lag)",
          "legendFormat": "{{consumergroup}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "row",
      "title": "Traces (Tempo)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "panels": []
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Spans per second by service and operation",
      "description": "From Tempo's span metrics: the sampled traffic, broken down the way the traces are.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum by (service, span_name) (rate(traces_spanmetrics_calls_total{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER\"}[1m]))",
          "legendFormat": "{{service}} {{span_name}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "p95 span duration",
      "description": "The slow hop in a trace usually shows here first. Producer spans include the acks=all wait; consumer spans include retries.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 39
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service, span_name) (rate(traces_spanmetrics_latency_bucket{span_kind=~\"SPAN_KIND_SERVER|SPAN_KIND_CONSUMER|SPAN_KIND_PRODUCER\"}[5m])))",
          "legendFormat": "{{service}} {{span_name}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "nodeGraph",
      "title": "Service graph",
      "description": "Who calls whom, from the traces: request rate and errors on each edge.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ]
    },
    {
      "id": 22,
      "type": "table",
      "title": "Records the gateway held, longest wait first",
      "description": "Traces whose ingest span says the record waited on the site B gateway's disk (gateway.queued_seconds). After a WAN cut, these are the backlog. Click a trace ID to open it.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ span.gateway.queued_seconds > 1.0 }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 23,
      "type": "table",
      "title": "Failed traces",
      "description": "Traces with an error span: failed sends at the edge, 5xx in the cloud, records the processor retried or skipped.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 55
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Logs (Loki)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 65
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Log lines by service and level",
      "description": "From the services' JSON logs. A jump in WARN or ERROR is often the first sign, before any metric moves.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 66
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (app, level) (count_over_time({namespace=\"connectivity\", app=~\"ingest-api|telemetry-processor|case-service|ai-triage\"} [1m]))",
          "legendFormat": "{{app}} {{level}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "logs",
      "title": "Warnings and errors",
      "description": "Newest first. Expand a line to see its fields; a trace_id links to the trace once services export traces.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"connectivity\", level=~\"WARN|ERROR\"}",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 17,
      "type": "logs",
      "title": "All logs for one service",
      "description": "Pick the service in the variable at the top.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 84
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"connectivity\", app=\"$app\"}",
          "queryType": "range"
        }
      ]
    }
  ]
}
